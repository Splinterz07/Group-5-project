const express = require('express');
const { Pool } = require('pg');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const cors = require('cors');

const app = express();
app.use(cors());
app.use(express.json());

// 1. DATABASE CONNECTION
// IMPORTANT: Change 'postgres:password' to your actual PostgreSQL username and password!
const pool = new Pool({
  connectionString: "postgresql://postgres:password@localhost:5432/bookify"
});

const JWT_SECRET = "your_secret_key";

// 2. AUTHENTICATION MIDDLEWARE
const authenticate = (req, res, next) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ message: 'Access Denied' });
  try {
    req.user = jwt.verify(token, JWT_SECRET);
    next();
  } catch (err) { 
    res.status(400).json({ message: 'Invalid Token' }); 
  }
};

// 3. ROUTES - AUTHENTICATION
app.post('/api/register', async (req, res) => {
  try {
    const { email, password, role } = req.body;
    const hashed = await bcrypt.hash(password, 10);
    await pool.query('INSERT INTO users (email, password, role) VALUES ($1, $2, $3)', [email, hashed, role || 'USER']);
    res.status(201).json({ message: 'User Registered Successfully' });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

app.post('/api/login', async (req, res) => {
  try {
    const { email, password } = req.body;
    const result = await pool.query('SELECT * FROM users WHERE email = $1', [email]);
    const user = result.rows[0];
    if (user && await bcrypt.compare(password, user.password)) {
      const token = jwt.sign({ userId: user.id, role: user.role }, JWT_SECRET);
      res.json({ token, role: user.role, userId: user.id });
    } else {
      res.status(401).json({ message: 'Invalid Credentials' });
    }
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// 4. ROUTES - EVENTS (Public)
app.get('/api/events', async (req, res) => {
  try {
    const result = await pool.query('SELECT * FROM events');
    res.json(result.rows);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// 5. ROUTES - BOOKING (User Workflow)
app.post('/api/bookings', authenticate, async (req, res) => {
  try {
    const { ticketId, quantity } = req.body;
    const ticketRes = await pool.query('SELECT * FROM tickets WHERE id = $1', [ticketId]);
    const ticket = ticketRes.rows[0];

    if (!ticket) return res.status(404).json({ message: 'Ticket not found' });

    if (ticket.quantity >= quantity) {
      const total = ticket.price * quantity;
      await pool.query('INSERT INTO bookings (user_id, ticket_id, quantity, total_price) VALUES ($1, $2, $3, $4)', 
        [req.user.userId, ticketId, quantity, total]);
      
      // Update ticket stock
      await pool.query('UPDATE tickets SET quantity = quantity - $1 WHERE id = $2', [quantity, ticketId]);
      
      res.status(201).json({ message: 'Booking Confirmed!' });
    } else {
      res.status(400).json({ message: 'Not enough tickets available!' });
    }
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// 6. ROUTES - ADMIN (Event Management)
app.post('/api/admin/events', authenticate, async (req, res) => {
  try {
    if (req.user.role !== 'ADMIN') return res.status(403).json({ message: 'Admins Only' });
    const { title, category, location, date } = req.body;
    const result = await pool.query('INSERT INTO events (title, category, location, date) VALUES ($1, $2, $3, $4) RETURNING id', 
      [title, category, location, date]);
    res.status(201).json({ message: 'Event Created', id: result.rows[0].id });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});


// START SERVER
const PORT = 5000;
app.listen(PORT, () => console.log(`Bookify Backend running on port ${PORT}`));